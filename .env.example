# Env variables template — COPIA este archivo a ~/.env y completa los valores
# NUNCA comittees este archivo ni ~/.env

# GitHub Personal Access Token (necesario para GitHub MCP)
# Crear en: https://github.com/settings/tokens
# Permisos mínimos: repo, read:org, read:user
GITHUB_TOKEN=ghp_TU_TOKEN_AQUI

# (Opcional) URL de base de datos para Postgres MCP
DATABASE_URL=postgresql://usuario:password@localhost:5432/mi_db
